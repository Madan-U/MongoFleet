# =============================================================================
# Unit        : mongofleet.service
# Description : Systemd service unit for MongoFleet — MongoDB DBA Platform.
#               Runs the gunicorn WSGI server as a long-lived daemon.
# Author      : Madan U
# Email       : madanu135@gmail.com
# Install     : sudo cp mongofleet.service /etc/systemd/system/
#               sudo systemctl daemon-reload
#               sudo systemctl enable --now mongofleet
# =============================================================================
[Unit]
Description=MongoFleet — MongoDB DBA Platform
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=<app_service_user>
Group=<app_service_user>
WorkingDirectory=/opt/mongofleet/backend
EnvironmentFile=/etc/mongofleet/.env
ExecStart=/opt/mongofleet/backend/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
