# =============================================================================
# MongoFleet — environment template
#
# Standard location on the server is /etc/mongofleet/.env (root:<app_service_user>,
# 640) — this is what systemd, cron, and manual runs all read via config.py.
#   sudo mkdir -p /etc/mongofleet
#   sudo cp .env.example /etc/mongofleet/.env
#   sudo chown root:<app_service_user> /etc/mongofleet/.env
#   sudo chmod 640 /etc/mongofleet/.env
#   sudo vi /etc/mongofleet/.env
# A copy at backend/.env still works as a dev-only fallback if
# /etc/mongofleet/.env doesn't exist, but don't keep both around.
# Never commit this file, never paste real values into chat/tickets/Slack.
# =============================================================================

ATLAS_ENV=prod

# Generate a fresh one on the server itself, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Do NOT reuse a key that has ever been typed into a chat window.
ATLAS_SECRET_KEY=CHANGE_ME_run_python_-c_secrets.token_hex(32)

SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=8

# --- PostgreSQL (platform metadata DB) --------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=CHANGE_ME
PG_USER=CHANGE_ME
PG_PASSWORD=CHANGE_ME

# --- SSH to managed MongoDB hosts -------------------------------------------
# Prefer key-based auth. One credential set per environment tier, referenced
# by servers.ssh_credential_ref (see services/credential_service.py) — never
# a single global OS account for every server.
SSH_KEY_PATH_PROD=/home/<app_service_user>/.ssh/<ssh_keyfile_prod>
SSH_KEY_PATH_NONPROD=/home/<app_service_user>/.ssh/<ssh_keyfile_nonprod>
SSH_USER_PROD=<ssh_username>
SSH_USER_NONPROD=<ssh_username>
# Only set a password var if key-based auth is genuinely unavailable for a
# tier — key auth is strongly preferred for anything that runs restarts.
# SSH_PASSWORD_NONPROD=

SSH_KNOWN_HOSTS_PATH=/home/<app_service_user>/.ssh/known_hosts
SSH_CONNECT_TIMEOUT=8
SSH_COMMAND_TIMEOUT=20

# --- MongoDB driver ----------------------------------------------------------
MONGO_CONNECT_TIMEOUT_MS=4000
MONGO_SERVER_SELECTION_TIMEOUT_MS=4000

# MongoDB auth, per credential tier (leave both blank if auth is disabled on
# the mongod instances themselves).
# MONGO_USER_NONPROD=
# MONGO_PASSWORD_NONPROD=
MONGO_AUTHSOURCE_NONPROD=admin

# --- Remote MongoDB host layout (custom install under the <ssh_username> OS user) --
# These describe the *DB host's* filesystem/service, not this app server.
# Only change these if your MongoDB hosts differ from the current fleet
# standard (/apps/DB/modb/...), managed via systemctl as unit "mongodb".
MONGO_SERVICE_NAME=mongodb
# mongodump/mongoexport/mongosh are on <ssh_username>'s PATH interactively, but a
# non-interactive SSH session may not source the same profile — set a full
# path here (e.g. /apps/DB/modb/mongodb_bin/mongodump) if backups fail with
# "command not found".
MONGODUMP_BIN=mongodump
# MONGODUMP_EXTRA_ARGS=
MONGO_BACKUP_DIR=/apps/DB/modb/backup
MONGO_LOG_PATH=/apps/DB/modb/log/mongod.log

LOG_DIR=/opt/mongofleet/logs
LOG_LEVEL=INFO

# --- Alerts ------------------------------------------------------------------
# Comma-separated list of delivery channels to attempt for each alert.
# "log" needs no setup and just writes to mongofleet.log — keep it in the
# list so alerts always show up in the UI even before email/Slack is wired.
# Add "email" once SMTP_* below are filled in.
ALERT_CHANNELS=log
# SMTP_HOST=smtp.yourcompany.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=mongofleet@yourcompany.com
# ALERT_EMAIL_TO=dba-team@yourcompany.com
